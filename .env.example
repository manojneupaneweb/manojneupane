# Environment Variables — Manoj Neupane Portfolio
# Copy to .env.local and fill in values for local development
# NEVER commit .env.local to version control

# Contact form email destination
CONTACT_EMAIL=manojneupaneweb@gmail.com

# SMTP settings for email delivery (optional — contact form logs to console if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user@gmail.com
# SMTP_PASS=your-app-password

# Site URL (used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://manoj-neupane.com.np

# Admin Portal Authentication
# Required to access /admin and /admin/analytics
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-random-32-byte-hex-secret

# Vercel Web Analytics REST API (Optional for historical reporting dashboard)
# 1. Create a Personal Access Token at https://vercel.com/account/tokens
# 2. Find your Project ID in Vercel Dashboard > Project Settings > General
VERCEL_API_TOKEN=your-vercel-personal-access-token
VERCEL_PROJECT_ID=prj_your_project_id
# VERCEL_TEAM_ID=team_your_team_id # Only if project belongs to a Vercel Team

